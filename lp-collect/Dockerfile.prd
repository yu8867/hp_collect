# Build Stage
FROM node:20-slim AS builder
WORKDIR /app

# === Build Args (Vite 本番環境変数) ===
ARG VITE_BASE_URL
ARG VITE_MAIL_API_URL=https://nexgen-web.com
ENV VITE_BASE_URL=$VITE_BASE_URL
ENV VITE_MAIL_API_URL=$VITE_MAIL_API_URL

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite は build 時の .env.production を読むため作成
RUN echo "VITE_BASE_URL=$VITE_BASE_URL" > .env.production && \
    echo "VITE_MAIL_API_URL=$VITE_MAIL_API_URL" >> .env.production

RUN npm run build

# Production Stage
FROM nginx:stable-alpine

# デフォルト nginx 設定を削除し SPA 設定へ差し替え
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

# ビルドした静的ファイルを配置
COPY --from=builder /app/dist /usr/share/nginx/html/

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
